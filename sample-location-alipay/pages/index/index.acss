.container {
    padding: 24rpx;
}
.header {
    padding: 36rpx 0;
    text-align: center;
    font-size: 44rpx;
    color: darkcyan;
}
.result {
    padding: 24rpx;
    margin: 16rpx 0;
    background: #f5f5f5;
    border-radius: 8rpx;
    font-size: 26rpx;
    min-height: 80rpx;
    word-break: break-all;
    white-space: pre-wrap;
}
.section-title {
    margin: 24rpx 0 8rpx;
    padding: 8rpx 12rpx;
    font-size: 26rpx;
    color: #888;
    border-left: 6rpx solid darkcyan;
}
.action {
    padding: 22rpx;
    text-align: center;
    margin: 12rpx 0;
    background: #72bbf7;
    color: #fff;
    border-radius: 8rpx;
    font-size: 28rpx;
}
.action.stop {
    background: #f56c6c;
}
